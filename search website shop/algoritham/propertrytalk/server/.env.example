# ==============================================================================
# PropertyTalk — Environment Configuration Template (Phase 3A Readiness)
# ==============================================================================
# Instructions:
# 1. Copy this file to `server/.env`
# 2. Fill in external service credentials when transitioning to real providers.
# 3. All external integrations safely fallback to local development mocks when unset.
# 4. NEVER commit real production secrets, private keys, or API tokens to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Database Settings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV="development"
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace_with_secure_random_jwt_secret_at_least_32_chars"
CLIENT_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# SMS Gateway Integration (Twilio)
# ------------------------------------------------------------------------------
# Provider options: "twilio" | "dev" (default: auto-detects based on TWILIO_ACCOUNT_SID)
SMS_PROVIDER="dev"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# Transactional Email Integration (Resend)
# ------------------------------------------------------------------------------
# Provider options: "resend" | "dev" (default: auto-detects based on RESEND_API_KEY)
EMAIL_PROVIDER="dev"
RESEND_API_KEY=""
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="notifications@propertytalk.com"
EMAIL_FROM_NAME="PropertyTalk"

# ------------------------------------------------------------------------------
# WebRTC Audio & Video ICE / STUN / TURN Configuration
# ------------------------------------------------------------------------------
# Standard Google public STUN servers are used by default if WEBRTC_STUN_URLS is empty.
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

# Optional TURN Relay Server (Coturn, Twilio Network Traversal, Xirsys, Metered.ca)
# Strongly recommended for production NAT traversal and mobile cellular carriers.
WEBRTC_TURN_URL=""
WEBRTC_TURN_USERNAME=""
WEBRTC_TURN_CREDENTIAL=""

# ------------------------------------------------------------------------------
# Payments & Marketplace Billing (Stripe Test Mode Only)
# ------------------------------------------------------------------------------
# Provider options: "stripe" | "mock" (default: auto-detects based on STRIPE_SECRET_KEY)
# CRITICAL SAFETY RULE: STRIPE LIVE KEYS (sk_live_...) ARE STRICTLY BLOCKED IN PHASE 3A!
# ONLY test mode keys (sk_test_... and pk_test_...) are permitted.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Browser Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Generate VAPID keypair via: npx web-push generate-vapid-keys
# When empty, the system gracefully falls back to Socket.io in-app notifications.
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:admin@propertytalk.com"

# ------------------------------------------------------------------------------
# System Governance & Platform Defaults
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="admin@propertytalk.com"
FREE_CALL_DURATION_SECONDS=60
AUTO_CHARGE_ENABLED=false

# ------------------------------------------------------------------------------
# Google Maps & Places Platform (Phase 4A)
# ------------------------------------------------------------------------------
# Server-side API key: Used by backend for Address Validation, Geocoding, and Places API (New)
# CRITICAL SECURITY: Restrict this key in Google Cloud Console by IP address (backend server IP)
# and restrict API scope strictly to: Address Validation API, Geocoding API, Places API (New).
# If left empty, system automatically falls back to deterministic local mock provider.
GOOGLE_MAPS_SERVER_API_KEY=""

# Client-side / Browser API key: Used by frontend for Google Maps Embed iframe
# CRITICAL SECURITY: Restrict this key in Google Cloud Console by HTTP referrer (e.g. https://yourdomain.com/*)
# and restrict API scope strictly to: Maps Embed API.
# NEVER expose GOOGLE_MAPS_SERVER_API_KEY to the browser!
VITE_GOOGLE_MAPS_BROWSER_API_KEY=""

# ------------------------------------------------------------------------------
# Authoritative New Zealand Property Data Integrations (Phase 4B)
# ------------------------------------------------------------------------------
# 1. Land Information New Zealand (LINZ) Data Service API
# Obtain an API key from: https://data.linz.govt.nz/
# Used for WFS Layer 50772 (NZ Primary Parcels & Legal Descriptions).
# When unset, system falls back to database attributes or WAITING_FOR_PROVIDER_CREDENTIALS.
LINZ_API_KEY=""

# 2. Commercial Automated Valuation Models (AVM)
# Used for real-time estimated market value, confidence levels, and value bands.
# In production, if unset, returns available: false (WAITING_FOR_PROVIDER_CREDENTIALS).
# Deterministic local dev benchmarks are strictly barred in production.
CORELOGIC_API_KEY=""
QV_API_KEY=""

# 3. MBIE Tenancy Services Market Rent
# Used for real-time median lodged bond statistics by territorial authority and suburb.
# Explicitly labeled "Area Market Rent" to distinguish from individual property appraisals.
MBIE_MARKET_RENT_API_KEY=""


