# ==============================================================================
# PropertyTalk — Environment Configuration Template (Phase 3A Readiness)
# ==============================================================================
# Instructions:
# 1. Copy this file to `server/.env`
# 2. Fill in external service credentials when transitioning to real providers.
# 3. All external integrations safely fallback to local development mocks when unset.
# 4. NEVER commit real production secrets, private keys, or API tokens to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Database Settings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV="development"
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace_with_secure_random_jwt_secret_at_least_32_chars"
CLIENT_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# SMS Gateway Integration (Twilio)
# ------------------------------------------------------------------------------
# Provider options: "twilio" | "dev" (default: auto-detects based on TWILIO_ACCOUNT_SID)
SMS_PROVIDER="dev"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# Transactional Email Integration (Resend)
# ------------------------------------------------------------------------------
# Provider options: "resend" | "dev" (default: auto-detects based on RESEND_API_KEY)
EMAIL_PROVIDER="dev"
RESEND_API_KEY=""
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="notifications@propertytalk.com"
EMAIL_FROM_NAME="PropertyTalk"

# ------------------------------------------------------------------------------
# WebRTC Audio & Video ICE / STUN / TURN Configuration
# ------------------------------------------------------------------------------
# Standard Google public STUN servers are used by default if WEBRTC_STUN_URLS is empty.
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

# Optional TURN Relay Server (Coturn, Twilio Network Traversal, Xirsys, Metered.ca)
# Strongly recommended for production NAT traversal and mobile cellular carriers.
WEBRTC_TURN_URL=""
WEBRTC_TURN_USERNAME=""
WEBRTC_TURN_CREDENTIAL=""

# ------------------------------------------------------------------------------
# Payments & Marketplace Billing (Stripe Test Mode Only)
# ------------------------------------------------------------------------------
# Provider options: "stripe" | "mock" (default: auto-detects based on STRIPE_SECRET_KEY)
# CRITICAL SAFETY RULE: STRIPE LIVE KEYS (sk_live_...) ARE STRICTLY BLOCKED IN PHASE 3A!
# ONLY test mode keys (sk_test_... and pk_test_...) are permitted.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Browser Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Generate VAPID keypair via: npx web-push generate-vapid-keys
# When empty, the system gracefully falls back to Socket.io in-app notifications.
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:admin@propertytalk.com"

# ------------------------------------------------------------------------------
# System Governance & Platform Defaults
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="admin@propertytalk.com"
FREE_CALL_DURATION_SECONDS=60
AUTO_CHARGE_ENABLED=false
